# ========================================================
# ClassPulse AI - Environment Configuration Example
# ========================================================

# PostgreSQL Database Connection String
# Compatible with Replit PostgreSQL, Supabase, Neon, or local Postgres.
# Example: postgresql://user:password@localhost:5432/classpulse
# If left empty in dev, an embedded PostgreSQL engine (PGlite) will initialize in data/pgdata.
DATABASE_URL=

# JSON Web Token Secret Key
# Used by Express backend for signing authentication tokens
JWT_SECRET=

# Google Gemini API Key
# Used exclusively server-side via @google/genai SDK for the Early Support Engine
GEMINI_API_KEY=

# Server Port (default 3000 in dev / 5000 in standalone backend)
PORT=3000

# Client API Base URL
# In Vite development / integrated mode, defaults to /api
VITE_API_BASE_URL=/api
