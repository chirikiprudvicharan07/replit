# ========================================================
# ClassPulse AI - Environment Configuration Example
# ========================================================

# Supabase PostgreSQL connection string.
# In Supabase Dashboard: Connect -> PostgreSQL -> Session pooler (recommended for hosted deployments).
# Keep the password URL-encoded if it contains special characters.
SUPABASE_DB_URL=
# Optional PEM CA certificate for environments where the Supabase pooler CA is
# not present in the Node.js trust store. Keep rejectUnauthorized enabled.
SUPABASE_DB_CA_CERT=

# Supabase Auth (Google sign-in)
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Generic PostgreSQL connection string fallback (used when SUPABASE_DB_URL is empty).
DATABASE_URL=

# Set true to prevent fallback to local PGlite when an external database cannot be reached.
DATABASE_REQUIRED=false
SEED_DEMO_DATA=true

# JSON Web Token Secret Key
# Used by Express backend for signing authentication tokens
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Comma-separated browser origins allowed to call the API.
# Leave empty for local development; configure this in production.
CORS_ORIGIN=

# Google Gemini API Key
# Used exclusively server-side via @google/genai SDK for the Early Support Engine
GEMINI_API_KEY=

# Server Port (default 3000 in dev / 5000 in standalone backend)
PORT=3000

# Client API Base URL
# In Vite development / integrated mode, defaults to /api
VITE_API_BASE_URL=/api
